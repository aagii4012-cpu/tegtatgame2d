// Cloudflare Workers тохиргоо (tegtatgame2d.aagii4012.workers.dev)
// D1: tegtat_scores (976faa16-ffb5-4729-9f9b-6f4b7aec1d95) — binding нэр "DB" байх ёстой.
{
  "name": "tegtatgame2d",
  "main": "src/worker.js",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tegtat_scores",
      "database_id": "976faa16-ffb5-4729-9f9b-6f4b7aec1d95"
    }
  ]
}
