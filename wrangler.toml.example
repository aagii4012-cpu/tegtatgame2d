# OPTIONAL. Зөвхөн wrangler CLI-аар deploy хийх бол энэ файлыг "wrangler.toml" болгож,
# database_id-г өөрийн D1-ийн ID-гаар солино. Dashboard-аар binding хийж байгаа бол
# энэ файл ХЭРЭГГҮЙ (wrangler.toml байвал dashboard-ын binding тохиргоог дарж бичнэ).

name = "enerel"
pages_build_output_dir = "."
compatibility_date = "2024-09-23"

[[d1_databases]]
binding = "DB"
database_name = "enerel-scores"
database_id = "PASTE-YOUR-D1-DATABASE-ID-HERE"
